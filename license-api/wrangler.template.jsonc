{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gams-license-api",
  "main": "src/license-lifecycle.js",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "LATEST_APP_VERSION": "11",
    "FORCE_UPDATE": "false",
    "UPDATE_URL": "",
    "UPDATE_MESSAGE": ""
  },
  "routes": [
    {
      "pattern": "license.xn--8pv109c.top",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gams-license-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
